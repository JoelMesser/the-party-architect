---
interface ItineraryDay {
  day: string;
  title: string;
  items: string[];
}

interface Props {
  days: ItineraryDay[];
}

const { days } = Astro.props;
---

<section class="py-16 md:py-24" aria-label="Itinerary">
  <div class="max-w-3xl mx-auto px-6 md:px-8">
    <h2 class="font-display text-3xl md:text-4xl font-medium text-ink text-center mb-16">
      Sample Weekend
    </h2>
    <div class="space-y-12">
      {days.map((day) => (
        <div class="relative pl-8 border-l-2 border-champagne/40">
          <div class="absolute -left-3 top-0 w-6 h-6 rounded-full bg-rose/20 border-2 border-rose flex items-center justify-center">
            <div class="w-2 h-2 rounded-full bg-rose" />
          </div>
          <h3 class="font-sans text-xl font-semibold text-ink mb-1">{day.day}</h3>
          <p class="font-sans text-sm text-rose font-medium mb-4">{day.title}</p>
          <ul class="space-y-2">
            {day.items.map((item) => (
              <li class="font-sans text-base text-ink leading-relaxed flex items-start gap-3">
                <span class="text-champagne mt-1.5 text-xs shrink-0">&#9679;</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
