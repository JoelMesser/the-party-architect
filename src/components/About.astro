---

---

<section class="relative py-16 md:py-24 overflow-hidden" aria-label="About">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8 items-center">
      <!-- Photo — asymmetric, editorial framing -->
      <div class="md:col-span-5 relative">
        <div class="relative">
          <!-- Decorative frame offset -->
          <div class="absolute -top-4 -left-4 w-full h-full border border-rose/20 rounded-2xl" aria-hidden="true"></div>
          <!-- Photo -->
          <div class="relative w-full aspect-[3/4] rounded-2xl overflow-hidden">
            <img
              src="/kat.webp"
              alt="Kat, founder of The Party Architect"
              class="w-full h-full object-cover"
              loading="lazy"
            />
            <!-- Subtle warm overlay to match palette -->
            <div class="absolute inset-0 bg-gradient-to-t from-ink/10 to-transparent"></div>
          </div>
        </div>
        <!-- Small accent below photo -->
        <div class="mt-6 flex items-center gap-3">
          <div class="h-px flex-1 bg-champagne/30"></div>
          <span class="font-display text-xs text-champagne italic">the one who plans the trip</span>
          <div class="h-px flex-1 bg-champagne/30"></div>
        </div>
      </div>

      <!-- Bio — right side, generous space -->
      <div class="md:col-span-6 md:col-start-7">
        <div class="flex items-center gap-4 mb-6">
          <div class="h-px w-12 bg-rose"></div>
          <p class="font-sans text-xs tracking-[0.15em] uppercase text-rose font-semibold">Meet Kat</p>
        </div>

        <h2 class="font-display text-4xl md:text-5xl font-normal text-ink leading-tight mb-8">
          Hi, I'm Kat.
        </h2>

        <div class="space-y-5 font-sans text-base md:text-lg text-ink/80 leading-relaxed">
          <p>
            I'm the friend who plans the trip. The one with the shared Google Doc, the restaurant list, the group text with the itinerary pinned at the top.
          </p>
          <p>
            I turned that into a business because I genuinely love it &mdash; and because your maid of honor shouldn't have to do all that alone.
          </p>
          <p>
            I design bachelorette weekends that feel <em class="font-display not-italic text-ink">curated, not chaotic.</em> Every detail &mdash; from the welcome bags to the dinner reservations to the aesthetic &mdash; is thought through so you can actually enjoy it.
          </p>
        </div>

        <div class="mt-10 pt-8 border-t border-champagne/20">
          <p class="font-sans text-sm text-muted">
            Based in the Southeast, planning weekends everywhere.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
