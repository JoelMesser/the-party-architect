---

---

<section class="relative min-h-[70vh] flex flex-col justify-center overflow-hidden">
  <!-- Hero background image with overlay -->
  <div class="absolute inset-0" aria-hidden="true">
    <img
      src="https://images.unsplash.com/photo-1647905555465-0f9004fbdaed?w=1920&q=80&auto=format&fit=crop"
      alt=""
      class="w-full h-full object-cover"
      loading="eager"
    />
    <!-- Gradient overlays for readability -->
    <div class="absolute inset-0 bg-gradient-to-b from-cream/90 via-cream/75 to-cream/95"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-cream/80 to-transparent"></div>
  </div>

  <!-- Subtle grain texture -->
  <div class="absolute inset-0 grain pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-6 md:px-12 w-full">
    <!-- Top bar with thin line -->
    <div class="flex items-center justify-between mb-10 md:mb-16 animate-fade-in" style="animation-delay: 0.2s">
      <div class="h-px flex-1 bg-champagne/30 mr-8"></div>
      <a href="https://instagram.com/__thepartyarchitect" target="_blank" rel="noopener noreferrer"
         class="font-sans text-xs tracking-[0.2em] uppercase text-muted hover:text-rose transition-colors">
        @__thepartyarchitect
      </a>
    </div>

    <!-- Brand name — the hero moment -->
    <div class="animate-fade-up" style="animation-delay: 0.3s">
      <h1 class="font-display font-normal tracking-tight leading-[0.9]">
        <span class="block text-[clamp(3.5rem,12vw,11rem)] text-ink">The Party</span>
        <span class="block text-[clamp(3.5rem,12vw,11rem)] text-ink ml-[5vw] md:ml-[8vw]">Architect</span>
      </h1>
    </div>

    <!-- Tagline and CTA row -->
    <div class="mt-10 md:mt-14 flex flex-col md:flex-row md:items-end md:justify-between gap-8 md:gap-16">
      <div class="max-w-lg animate-fade-up" style="animation-delay: 0.6s">
        <div class="flex items-center gap-4 mb-5">
          <div class="h-px w-12 bg-rose animate-draw-line" style="animation-delay: 0.8s"></div>
          <p class="font-sans text-xs tracking-[0.15em] uppercase text-rose font-semibold">
            Bachelorette Weekend Design
          </p>
        </div>
        <p class="font-display text-2xl md:text-3xl font-normal text-ink leading-snug mb-3">
          Planning, but make it aesthetic.
        </p>
        <p class="font-sans text-base md:text-lg text-muted leading-relaxed">
          Custom 2&ndash;3 day weekends, designed end-to-end. Itinerary, theme, restaurants, the whole thing. You just show up.
        </p>
      </div>

      <div class="animate-fade-up" style="animation-delay: 0.9s">
        <a
          href="#contact"
          class="group inline-flex items-center gap-3 bg-ink text-cream font-sans text-sm font-semibold tracking-wide
                 py-4 px-8 rounded-full
                 hover:bg-rose hover:scale-[1.03]
                 active:scale-[0.98]
                 transition-all duration-300"
        >
          Start planning
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Bottom decorative element -->
    <div class="mt-12 md:mt-20 flex items-center gap-6 animate-fade-in" style="animation-delay: 1.2s">
      <div class="h-px flex-1 bg-champagne/30"></div>
      <span class="font-display text-sm text-champagne italic">est. 2024</span>
      <div class="h-px flex-1 bg-champagne/30"></div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-float">
    <div class="w-5 h-8 rounded-full border border-champagne/50 flex items-start justify-center p-1.5">
      <div class="w-1 h-2 rounded-full bg-champagne/60"></div>
    </div>
  </div>
</section>
