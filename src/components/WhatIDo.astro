---

---

<section class="relative py-16 md:py-24 overflow-hidden" aria-label="Services">
  <!-- Subtle background accent -->
  <div class="absolute top-0 right-0 w-1/2 h-full bg-blush/30 -skew-x-12 origin-top-right pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-6 md:px-12">
    <!-- Section header — editorial style, left-aligned -->
    <div class="mb-10 md:mb-14">
      <div class="flex items-center gap-4 mb-6">
        <div class="h-px w-12 bg-rose"></div>
        <p class="font-sans text-xs tracking-[0.15em] uppercase text-rose font-semibold">Services</p>
      </div>
      <h2 class="font-display text-4xl md:text-6xl font-normal text-ink leading-tight max-w-2xl">
        Every detail,<br />thought through.
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-6">
      <!-- Signature Design — takes more visual weight -->
      <div class="md:col-span-7 bg-white/60 backdrop-blur-sm border border-champagne/20 rounded-3xl p-8 md:p-12 relative group hover:border-rose/30 transition-colors duration-500 overflow-hidden">
        <!-- Decorative image strip -->
        <div class="mb-8 -mx-8 md:-mx-12 -mt-8 md:-mt-12 h-48 md:h-56 overflow-hidden relative">
          <img
            src="https://images.unsplash.com/photo-1519671482749-fd09be7ccebf?w=1200&q=80&auto=format&fit=crop"
            alt="Beautifully styled table setting with warm golden lighting"
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-white/60"></div>
        </div>
        <div class="absolute top-56 md:top-64 right-8 md:right-12">
          <span class="font-display text-6xl md:text-7xl text-champagne/15 leading-none select-none">01</span>
        </div>
        <p class="font-sans text-xs tracking-[0.15em] uppercase text-champagne font-semibold mb-4">Primary Service</p>
        <h3 class="font-display text-2xl md:text-3xl font-normal text-ink mb-4">
          Signature Design
        </h3>
        <p class="font-sans text-base text-muted leading-relaxed mb-8 max-w-md">
          A fully styled bachelorette weekend, planned end-to-end. This is the full experience.
        </p>
        <ul class="space-y-4 font-sans text-base text-ink">
          <li class="flex items-center gap-4">
            <span class="w-1.5 h-1.5 rounded-full bg-rose shrink-0"></span>
            Custom 2&ndash;3 day itinerary
          </li>
          <li class="flex items-center gap-4">
            <span class="w-1.5 h-1.5 rounded-full bg-rose shrink-0"></span>
            Destination + accommodation guidance
          </li>
          <li class="flex items-center gap-4">
            <span class="w-1.5 h-1.5 rounded-full bg-rose shrink-0"></span>
            Restaurant + activity recommendations
          </li>
          <li class="flex items-center gap-4">
            <span class="w-1.5 h-1.5 rounded-full bg-rose shrink-0"></span>
            Full theme + aesthetic concept
          </li>
          <li class="flex items-center gap-4">
            <span class="w-1.5 h-1.5 rounded-full bg-rose shrink-0"></span>
            Welcome bags, decor direction &amp; more
          </li>
        </ul>
      </div>

      <!-- Add-ons — smaller, offset card -->
      <div class="md:col-span-5 md:mt-16">
        <div class="bg-white/60 backdrop-blur-sm border border-champagne/20 rounded-3xl p-8 md:p-10 relative group hover:border-champagne/50 transition-colors duration-500 overflow-hidden">
          <!-- Small detail image -->
          <div class="mb-6 -mx-8 md:-mx-10 -mt-8 md:-mt-10 h-36 overflow-hidden relative">
            <img
              src="https://images.unsplash.com/photo-1765946023933-2076c133cfbb?w=800&q=80&auto=format&fit=crop"
              alt="Champagne glasses and party styling details"
              class="w-full h-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-b from-transparent to-white/60"></div>
          </div>
          <div class="absolute top-44 right-8 md:right-10">
            <span class="font-display text-6xl text-champagne/15 leading-none select-none">02</span>
          </div>
          <p class="font-sans text-xs tracking-[0.15em] uppercase text-champagne font-semibold mb-4">Add-ons</p>
          <h3 class="font-display text-2xl font-normal text-ink mb-4">
            Make It Seamless
          </h3>
          <p class="font-sans text-base text-muted leading-relaxed mb-8">
            Layer on extras to take your weekend from planned to effortless.
          </p>
          <ul class="space-y-4 font-sans text-base text-ink">
            <li class="flex items-center gap-4">
              <span class="w-1.5 h-1.5 rounded-full bg-champagne shrink-0"></span>
              Additional revisions
            </li>
            <li class="flex items-center gap-4">
              <span class="w-1.5 h-1.5 rounded-full bg-champagne shrink-0"></span>
              Booking assistance
            </li>
            <li class="flex items-center gap-4">
              <span class="w-1.5 h-1.5 rounded-full bg-champagne shrink-0"></span>
              Custom welcome bag curation
            </li>
          </ul>
        </div>

        <!-- Pull-quote decoration -->
        <div class="mt-8 pl-6 border-l-2 border-rose/30">
          <p class="font-display text-lg text-ink/70 italic leading-relaxed">
            &ldquo;Your maid of honor shouldn&rsquo;t have to plan the whole thing alone.&rdquo;
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
