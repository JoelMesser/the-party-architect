---
const steps = [
  {
    number: '01',
    title: 'Tell me the vibe',
    description: 'Destination, budget, group size, and any can\'t-miss requests.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>`,
  },
  {
    number: '02',
    title: 'I send the agreement',
    description: 'Paperwork and deposit — easy and official.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 13H8"/><path d="M16 17H8"/><path d="M16 13h-2"/></svg>`,
  },
  {
    number: '03',
    title: 'I build the plan',
    description: 'Itinerary, restaurants, theme, outfits, decor — the whole weekend.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>`,
  },
  {
    number: '04',
    title: 'You get the doc',
    description: 'Beautiful, organized, shareable with the group.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>`,
  },
  {
    number: '05',
    title: 'Show up',
    description: 'Enjoy every second.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5.8 11.3 2 22l10.7-3.79"/><path d="M4 3h.01"/><path d="M22 8h.01"/><path d="M15 2h.01"/><path d="M22 20h.01"/><path d="m22 2-2.24.75a2.9 2.9 0 0 0-1.96 3.12c.1.86-.57 1.63-1.45 1.63h-.38c-.86 0-1.6.6-1.76 1.44L14 10"/><path d="m22 13-.82-.33c-.86-.34-1.82.2-1.98 1.11c-.11.7-.72 1.22-1.43 1.22H17"/><path d="m11 2 .33.82c.34.86-.2 1.82-1.11 1.98C9.52 4.9 9 5.52 9 6.23V7"/><path d="M11 13c1.93 1.93 2.83 4.17 2 5-.83.83-3.07-.07-5-2-1.93-1.93-2.83-4.17-2-5 .83-.83 3.07.07 5 2Z"/></svg>`,
  },
];
---

<section class="relative py-16 md:py-24 bg-ink overflow-hidden" aria-label="How it works">
  <!-- Decorative background -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 left-1/4 w-[400px] h-[400px] rounded-full bg-rose/5 blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-[300px] h-[300px] rounded-full bg-champagne/5 blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-6 md:px-12">
    <!-- Section header -->
    <div class="text-center mb-12 md:mb-16">
      <div class="flex items-center justify-center gap-4 mb-6">
        <div class="h-px w-8 bg-champagne/40"></div>
        <p class="font-sans text-xs tracking-[0.15em] uppercase text-champagne/70 font-semibold">The Process</p>
        <div class="h-px w-8 bg-champagne/40"></div>
      </div>
      <h2 class="font-display text-4xl md:text-6xl font-normal text-cream leading-tight">
        Five steps to<br />your best weekend.
      </h2>
    </div>

    <!-- Steps — horizontal timeline on desktop, vertical on mobile -->
    <div class="hidden md:block">
      <!-- Connecting line -->
      <div class="relative mb-12">
        <div class="absolute top-1/2 left-0 right-0 h-px bg-gradient-to-r from-transparent via-champagne/30 to-transparent"></div>
        <div class="flex justify-between">
          {steps.map((step) => (
            <div class="relative flex flex-col items-center">
              <div class="w-3 h-3 rounded-full bg-rose border-2 border-ink ring-4 ring-ink"></div>
            </div>
          ))}
        </div>
      </div>

      <!-- Step cards -->
      <div class="grid grid-cols-5 gap-4">
        {steps.map((step, i) => (
          <div class:list={[
            "group text-center",
            i % 2 === 1 ? "mt-8" : ""
          ]}>
            <span class="font-display text-4xl text-champagne/20 block mb-3 transition-colors duration-300 group-hover:text-champagne/40">
              {step.number}
            </span>
            <div class="text-rose/70 mb-4 flex justify-center transition-colors duration-300 group-hover:text-rose" set:html={step.icon} />
            <h3 class="font-display text-lg font-normal text-cream mb-2">
              {step.title}
            </h3>
            <p class="font-sans text-sm text-cream/50 leading-relaxed">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Mobile: vertical layout -->
    <div class="md:hidden space-y-10">
      {steps.map((step) => (
        <div class="flex gap-6">
          <div class="flex flex-col items-center shrink-0">
            <div class="w-3 h-3 rounded-full bg-rose"></div>
            <div class="w-px flex-1 bg-champagne/20 mt-2"></div>
          </div>
          <div class="pb-2">
            <span class="font-display text-3xl text-champagne/25 block mb-1">{step.number}</span>
            <div class="text-rose/70 mb-3" set:html={step.icon} />
            <h3 class="font-display text-lg font-normal text-cream mb-1">{step.title}</h3>
            <p class="font-sans text-sm text-cream/50 leading-relaxed">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
