---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import DestinationHero from '../../components/DestinationHero.astro';
import Itinerary from '../../components/Itinerary.astro';
import Footer from '../../components/Footer.astro';

const days = [
  {
    day: 'Friday',
    title: 'Arrive & unwind',
    items: [
      'Check in at the private rental — mid-century modern, pool ready.',
      'Pool, charcuterie, and ros\u00e9. No agenda, just vibes.',
      'Dinner at Workshop Kitchen + Bar — seasonal, beautiful, and walkable from downtown.',
      'One drink at Bootlegger Tiki for something fun and unexpected.',
    ],
  },
  {
    day: 'Saturday',
    title: 'Slow luxury',
    items: [
      'Slow morning — coffee by the pool, no rush.',
      'Brunch at Cheeky\'s — local favorite, worth the wait.',
      'Afternoon at Two Bunch Palms spa — hot springs, massages, full reset.',
      'Private chef taco night at the rental — no reservations, no driving, just good food and good company.',
      'Movie under the stars by the pool.',
    ],
  },
  {
    day: 'Sunday',
    title: 'Golden hour & goodbye',
    items: [
      'Brunch at Farm — fresh, light, and the perfect cap.',
      'Optional: golden-hour drive to Joshua Tree (40 min) for photos and desert magic.',
      'Last pool session, then airport. Already planning the reunion trip.',
    ],
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Palm Springs Bachelorette Weekend Itinerary — Pool Days and Slow Mornings',
  description: 'A sample 3-day Palm Springs bachelorette weekend: private pool house, spa day, private chef dinner, and desert golden-hour vibes.',
  author: { '@type': 'Organization', name: 'The Party Architect' },
  publisher: { '@type': 'Organization', name: 'The Party Architect' },
};
---

<BaseLayout>
  <SEO
    slot="head"
    title="Palm Springs Bachelorette Itinerary — The Party Architect"
    description="A curated 3-day Palm Springs bachelorette weekend: private pool house, spa day, desert golden hour. Custom-planned by The Party Architect."
    ogType="article"
    jsonLd={jsonLd}
  />

  <main>
    <DestinationHero
      destination="Palm Springs"
      tagline="Pool Days and Slow Mornings"
      vibe="Chill & low-key"
      groupSize="Group of 6"
      budget="$700–$1,200/person"
      days="3 days"
      heroImage="https://images.unsplash.com/photo-1540541338287-41700207dee6?w=1920&q=80&auto=format&fit=crop"
      heroImageAlt="Turquoise pool surrounded by palm trees in warm sunlight"
    />

    <section class="bg-blush/50 py-16 md:py-24">
      <div class="max-w-3xl mx-auto px-6 md:px-8">
        <p class="font-sans text-base md:text-lg text-ink leading-relaxed mb-6">
          Palm Springs is for the bride who doesn't want a rager — she wants a beautiful, relaxed weekend with her closest people. Think mid-century pool house, spa afternoons, private chef dinners, and golden-hour drives through the desert. Slow, intentional, gorgeous.
        </p>
        <p class="font-sans text-base md:text-lg text-ink leading-relaxed">
          Here's a sample 3-day weekend. This is a concept itinerary — yours would be fully custom based on your group size, budget, and how much (or how little) you want to do.
        </p>
      </div>
    </section>

    <Itinerary days={days} />

    <section class="bg-blush/50 py-16 md:py-24">
      <div class="max-w-3xl mx-auto px-6 md:px-8">
        <h2 class="font-display text-2xl md:text-3xl font-medium text-ink mb-8">Where to Stay</h2>
        <div class="space-y-4 font-sans text-base text-ink leading-relaxed">
          <p><strong class="font-semibold">Korakia Pensione</strong> — Moroccan-Mediterranean boutique hotel, stunning pool area. ~$450/night.</p>
          <p><strong class="font-semibold">Ace Hotel & Swim Club</strong> — the classic PS pick, great pool scene, walkable. ~$300/night.</p>
          <p><strong class="font-semibold">Private mid-century rental</strong> — the best option for groups. Your own pool, kitchen, and yard. $1,200–$2,500/night for 6+.</p>
        </div>

        <h2 class="font-display text-2xl md:text-3xl font-medium text-ink mt-12 mb-8">The Aesthetic</h2>
        <p class="font-sans text-base text-ink leading-relaxed">
          Terracotta, cream, dusty pink, and sage. Matching robes, citrus-printed napkins, hand-lettered itinerary cards. Desert minimalism meets warm hospitality.
        </p>
      </div>
    </section>

    <section class="py-16 md:py-24 text-center">
      <div class="max-w-xl mx-auto px-6 md:px-8">
        <h2 class="font-display text-2xl md:text-3xl font-medium text-ink mb-4">Love this vibe?</h2>
        <p class="font-sans text-base text-muted leading-relaxed mb-8">
          This is just a sample. I'll build your Palm Springs weekend around your group, your budget, and your pace.
        </p>
        <a
          href="/#contact"
          class="inline-block bg-rose text-cream font-sans font-semibold tracking-wide
                 py-3 px-8 rounded-lg
                 hover:bg-rose/90 hover:scale-[1.02]
                 active:scale-[0.99]
                 transition-all duration-200"
        >
          Start planning
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
